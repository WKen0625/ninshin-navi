# Supabase（リージョン: 東京）。値は Supabase ダッシュボード → Project Settings で確認する。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 「その他」の自由記述（document_suggestions）をサーバーから保存するための鍵。ブラウザに出さない。
SUPABASE_SERVICE_ROLE_KEY=

# pnpm seed 専用（サーバー側のみ。ブラウザに出さない）。
# Project Settings → Database → Connection string（Session pooler）。
DATABASE_URL=

# 記録の重複防止用の秘密値（reporter_hash = sha256(端末ID + この値)）。`openssl rand -hex 32` で作る。ブラウザに出さない。
REPORTER_HASH_SECRET=

# ---- メール通知（Week 8）----
# メールの中のリンク（登録の完了・通知をやめる）に付ける署名の秘密値。`openssl rand -hex 32` で作る。
NOTIFY_LINK_SECRET=
# 週1回の cron（/api/cron/notify）を呼べる人を限るための値。Vercel の環境変数にも同じ値を入れる。`openssl rand -hex 32`
CRON_SECRET=
# メール送信（Resend https://resend.com ）。未設定だとメールは送られない（本番では登録も受け付けない）。
RESEND_API_KEY=
# 差出人。Resend で確認済みのドメインのアドレス。例: 妊娠手続きナビ <notify@example.jp>
MAIL_FROM=
# メールの中のリンクの先頭。本番のURL（例: https://example.jp）。未設定なら http://localhost:3100
NEXT_PUBLIC_SITE_URL=

# ---- 変更監視（Week 9）----
# 差分の要約（Claude Haiku）に使う。未設定でも監視は動き、機械的な差分だけが残る。
ANTHROPIC_API_KEY=
# 変更が見つかった週に知らせる先（メール送信の設定が必要）。未設定なら pnpm watch:report で見る。
ADMIN_EMAIL=
