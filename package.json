{
  "name": "ninshin-navi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "seed:check": "tsx scripts/seed.ts --check",
    "db:apply": "tsx --env-file-if-exists=.env.local scripts/apply-schema.ts",
    "db:check-rls": "tsx --env-file-if-exists=.env.local scripts/check-rls.ts",
    "notify:run": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/notify.ts",
    "watch:run": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/source-watch.ts",
    "watch:report": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/source-watch.ts --report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
